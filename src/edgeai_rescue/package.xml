<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
           schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>edgeai_rescue</name>
  <version>0.0.0</version>

  <description>
    Task 2 multi-robot rescue baseline: a centralized greedy task planner and
    per-robot controllers that execute rescues through Nav2.
  </description>

  <maintainer email="kahounjosef3@gmail.com">kahoujo1</maintainer>

  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>edgeai_rescue_interfaces</exec_depend>
  <exec_depend>edgeai_robot_description</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
