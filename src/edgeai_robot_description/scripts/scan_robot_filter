#!/usr/bin/env python3
"""Remove the other robots from this robot's LiDAR scan before SLAM.

Otherwise each robot's SLAM map records the other robot wherever it saw it, and
map_merge spreads these ghost obstacles into every robot's merged map.

Every robot has its own TF tree (/<robot>/tf); map_merge links them through the shared
world frame. Rays that end within `radius` of another robot are set to +inf (no
return), so SLAM neither marks the other robot nor clears the space behind it. Until
world exists in the trees (map_merge not running yet) scans pass through unfiltered.
The costmaps keep the raw scan, so live collision avoidance still sees other robots.
"""
import math

from geometry_msgs.msg import PointStamped
import rclpy
from rclpy.node import Node
from rclpy.qos import DurabilityPolicy, QoSProfile, qos_profile_sensor_data
from rclpy.time import Time
from sensor_msgs.msg import LaserScan
from tf2_geometry_msgs import do_transform_point
from tf2_msgs.msg import TFMessage
from tf2_ros import Buffer, TransformException, TransformListener


def mask_ranges(ranges, angle_min, angle_increment, others, radius):
    """Ranges with every ray that ends within radius of a point in others (scan frame) set to inf."""
    masked = list(ranges)
    for i, r in enumerate(masked):
        if not math.isfinite(r):
            continue
        a = angle_min + i * angle_increment
        x, y = r * math.cos(a), r * math.sin(a)
        if any(math.hypot(x - ox, y - oy) < radius for ox, oy in others):
            masked[i] = math.inf
    return masked


class ScanRobotFilter(Node):

    def __init__(self):
        super().__init__('scan_robot_filter')
        other_robots = self.declare_parameter('other_robots', ['robot2']).value
        self.radius = self.declare_parameter('radius', 0.35).value
        self.world_frame = self.declare_parameter('world_frame', 'world').value
        self.base_frame = self.declare_parameter('base_frame', 'base_footprint').value

        # Own tree: the launch file remaps /tf and /tf_static to this robot's topics
        self.tf = Buffer()
        self.tf_listener = TransformListener(self.tf, self)
        # Other robots' trees, filled by hand from their /<robot>/tf topics
        self.other_tf = {}
        static_qos = QoSProfile(depth=100, durability=DurabilityPolicy.TRANSIENT_LOCAL)
        for robot in other_robots:
            buf = Buffer()
            self.other_tf[robot] = buf
            self.create_subscription(
                TFMessage, f'/{robot}/tf', lambda m, b=buf: self.store(b, m, False), 100)
            self.create_subscription(
                TFMessage, f'/{robot}/tf_static', lambda m, b=buf: self.store(b, m, True),
                static_qos)

        self.pub = self.create_publisher(LaserScan, 'scan_filtered', qos_profile_sensor_data)
        self.create_subscription(LaserScan, 'scan', self.on_scan, qos_profile_sensor_data)

    @staticmethod
    def store(buf, msg, static):
        for t in msg.transforms:
            if static:
                buf.set_transform_static(t, 'scan_robot_filter')
            else:
                buf.set_transform(t, 'scan_robot_filter')

    def other_positions(self, frame):
        """Other robots' centres (x, y) in frame; empty while the TF trees are incomplete."""
        try:
            world_to_scan = self.tf.lookup_transform(frame, self.world_frame, Time())
        except TransformException:
            return []
        positions = []
        for buf in self.other_tf.values():
            try:
                t = buf.lookup_transform(self.world_frame, self.base_frame, Time())
            except TransformException:
                continue
            p = PointStamped()
            p.point.x, p.point.y = t.transform.translation.x, t.transform.translation.y
            q = do_transform_point(p, world_to_scan).point
            positions.append((q.x, q.y))
        return positions

    def on_scan(self, scan):
        others = self.other_positions(scan.header.frame_id)
        if others:
            scan.ranges = mask_ranges(
                scan.ranges, scan.angle_min, scan.angle_increment, others, self.radius)
        self.pub.publish(scan)


def main():
    rclpy.init()
    try:
        rclpy.spin(ScanRobotFilter())
    except KeyboardInterrupt:
        pass
    finally:
        rclpy.try_shutdown()


if __name__ == '__main__':
    main()
