<?xml version="1.0" ?>
<!--
  Rooms - 8 x 6 m hall with three rooms (scenario rooms)
  Generated by scripts/make_world.py from scenarios/rooms.yaml - edit that file, not this one.
  World frame = map frame: maps/rooms.* is rasterized from this file.
-->

<sdf version="1.9">

  <world name="rooms">

    <!-- Physics -->
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Gazebo core systems -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Required for GPU LiDAR / camera sensors -->
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Ground -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Boundary walls (inner faces on the edges of the [0, w] x [0, h] area) -->

    <!-- south_wall: boundary -->
    <model name="south_wall">
      <static>true</static>
      <pose>4 -0.05 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.2 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.2 0.1 0.5</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- north_wall: boundary -->
    <model name="north_wall">
      <static>true</static>
      <pose>4 6.05 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.2 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.2 0.1 0.5</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- west_wall: boundary -->
    <model name="west_wall">
      <static>true</static>
      <pose>-0.05 3 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 6.2 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 6.2 0.5</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- east_wall: boundary -->
    <model name="east_wall">
      <static>true</static>
      <pose>8.05 3 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 6.2 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 6.2 0.5</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Inner walls -->

    <!-- H_west: (0, 3) -> (1.6, 3) -->
    <model name="H_west">
      <static>true</static>
      <pose>0.8 3 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.6 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.6 0.1 0.5</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- H_mid: (2.8, 3) -> (5.2, 3) -->
    <model name="H_mid">
      <static>true</static>
      <pose>4 3 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.4 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.4 0.1 0.5</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- H_east: (6.4, 3) -> (8, 3) -->
    <model name="H_east">
      <static>true</static>
      <pose>7.2 3 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.6 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.6 0.1 0.5</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- V_west_a: (3, 3) -> (3, 4.4) -->
    <model name="V_west_a">
      <static>true</static>
      <pose>3 3.7 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 1.4 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 1.4 0.5</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- V_west_b: (3, 5.6) -> (3, 6) -->
    <model name="V_west_b">
      <static>true</static>
      <pose>3 5.8 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 0.4 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.4 0.5</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- V_east_a: (5, 3) -> (5, 4) -->
    <model name="V_east_a">
      <static>true</static>
      <pose>5 3.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 1 0.5</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- V_east_b: (5, 5.2) -> (5, 6) -->
    <model name="V_east_b">
      <static>true</static>
      <pose>5 5.6 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 0.8 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.8 0.5</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- divider: (4, 0) -> (4, 1.8) -->
    <model name="divider">
      <static>true</static>
      <pose>4 0.9 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 1.8 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 1.8 0.5</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle boxes -->

    <!-- O1: centre (6.2, 1.4), 0.8 x 0.8 -->
    <model name="O1">
      <static>true</static>
      <pose>6.2 1.4 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8 0.8 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.8 0.4</size></box></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- O2: centre (2, 1.6), 0.6 x 0.6 -->
    <model name="O2">
      <static>true</static>
      <pose>2 1.6 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.6 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 0.4</size></box></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Targets: ArUco stands, pose = target reference point, yaw = direction the marker faces -->

    <include>
      <name>target_S1</name>
      <uri>model://aruco_stand_1</uri>
      <pose>0.1 4.5 0 0 0 0</pose>
    </include>

    <include>
      <name>target_S2</name>
      <uri>model://aruco_stand_2</uri>
      <pose>4 5.9 0 0 0 -1.5708</pose>
    </include>

    <include>
      <name>target_C1</name>
      <uri>model://aruco_stand_3</uri>
      <pose>6.5 5.9 0 0 0 -1.5708</pose>
    </include>

    <include>
      <name>target_S3</name>
      <uri>model://aruco_stand_4</uri>
      <pose>7.9 3.7 0 0 0 3.1416</pose>
    </include>

    <include>
      <name>target_S4</name>
      <uri>model://aruco_stand_5</uri>
      <pose>7.9 0.6 0 0 0 3.1416</pose>
    </include>

    <include>
      <name>target_C2</name>
      <uri>model://aruco_stand_6</uri>
      <pose>3 0.1 0 0 0 1.5708</pose>
    </include>

    <include>
      <name>target_S5</name>
      <uri>model://aruco_stand_7</uri>
      <pose>4.1 1 0 0 0 0</pose>
    </include>

    <include>
      <name>target_S6</name>
      <uri>model://aruco_stand_8</uri>
      <pose>0.8 3.1 0 0 0 1.5708</pose>
    </include>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.15 0.15 0.15 1</background>
      <shadows>true</shadows>
    </scene>

  </world>

</sdf>
