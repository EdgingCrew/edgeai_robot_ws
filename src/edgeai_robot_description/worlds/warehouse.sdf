<?xml version="1.0" ?>
<!--
  Warehouse - 8 x 8 m with shelf rows (scenario warehouse)
  Generated by scripts/make_world.py from scenarios/warehouse.yaml - edit that file, not this one.
  World frame = map frame: maps/warehouse.* is rasterized from this file.
-->

<sdf version="1.9">

  <world name="warehouse">

    <!-- Physics -->
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Gazebo core systems -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Required for GPU LiDAR / camera sensors -->
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Ground -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Boundary walls (inner faces on the edges of the [0, w] x [0, h] area) -->

    <!-- south_wall: boundary -->
    <model name="south_wall">
      <static>true</static>
      <pose>4 -0.05 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.2 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.2 0.1 0.5</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- north_wall: boundary -->
    <model name="north_wall">
      <static>true</static>
      <pose>4 8.05 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.2 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.2 0.1 0.5</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- west_wall: boundary -->
    <model name="west_wall">
      <static>true</static>
      <pose>-0.05 4 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 8.2 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 8.2 0.5</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- east_wall: boundary -->
    <model name="east_wall">
      <static>true</static>
      <pose>8.05 4 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 8.2 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 8.2 0.5</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle boxes -->

    <!-- shelf_w1: centre (2.3, 2.3), 2.2 x 0.5 -->
    <model name="shelf_w1">
      <static>true</static>
      <pose>2.3 2.3 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.2 0.5 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.2 0.5 0.4</size></box></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- shelf_w2: centre (2.3, 4), 2.2 x 0.5 -->
    <model name="shelf_w2">
      <static>true</static>
      <pose>2.3 4 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.2 0.5 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.2 0.5 0.4</size></box></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- shelf_w3: centre (2.3, 5.7), 2.2 x 0.5 -->
    <model name="shelf_w3">
      <static>true</static>
      <pose>2.3 5.7 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.2 0.5 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.2 0.5 0.4</size></box></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- shelf_e1: centre (5.7, 2.3), 2.2 x 0.5 -->
    <model name="shelf_e1">
      <static>true</static>
      <pose>5.7 2.3 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.2 0.5 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.2 0.5 0.4</size></box></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- shelf_e2: centre (5.7, 4), 2.2 x 0.5 -->
    <model name="shelf_e2">
      <static>true</static>
      <pose>5.7 4 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.2 0.5 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.2 0.5 0.4</size></box></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- shelf_e3: centre (5.7, 5.7), 2.2 x 0.5 -->
    <model name="shelf_e3">
      <static>true</static>
      <pose>5.7 5.7 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.2 0.5 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.2 0.5 0.4</size></box></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Targets: ArUco stands, pose = target reference point, yaw = direction the marker faces -->

    <include>
      <name>target_C1</name>
      <uri>model://aruco_stand_1</uri>
      <pose>4 7.9 0 0 0 -1.5708</pose>
    </include>

    <include>
      <name>target_S1</name>
      <uri>model://aruco_stand_2</uri>
      <pose>0.1 7 0 0 0 0</pose>
    </include>

    <include>
      <name>target_S2</name>
      <uri>model://aruco_stand_3</uri>
      <pose>7.9 7.2 0 0 0 3.1416</pose>
    </include>

    <include>
      <name>target_C2</name>
      <uri>model://aruco_stand_4</uri>
      <pose>7.9 1 0 0 0 3.1416</pose>
    </include>

    <include>
      <name>target_S3</name>
      <uri>model://aruco_stand_5</uri>
      <pose>2.3 2 0 0 0 -1.5708</pose>
    </include>

    <include>
      <name>target_S4</name>
      <uri>model://aruco_stand_6</uri>
      <pose>5.7 3.7 0 0 0 -1.5708</pose>
    </include>

    <include>
      <name>target_C3</name>
      <uri>model://aruco_stand_7</uri>
      <pose>2.3 5.4 0 0 0 -1.5708</pose>
    </include>

    <include>
      <name>target_S5</name>
      <uri>model://aruco_stand_8</uri>
      <pose>4.55 4 0 0 0 3.1416</pose>
    </include>

    <include>
      <name>target_S6</name>
      <uri>model://aruco_stand_9</uri>
      <pose>6 7.9 0 0 0 -1.5708</pose>
    </include>

    <include>
      <name>target_S7</name>
      <uri>model://aruco_stand_10</uri>
      <pose>7.9 4.8 0 0 0 3.1416</pose>
    </include>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.15 0.15 0.15 1</background>
      <shadows>true</shadows>
    </scene>

  </world>

</sdf>
