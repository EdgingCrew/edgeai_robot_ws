<?xml version="1.0" ?>
<!--
  Midterm Check arena with 6 targets (scenario midterm_plus)
  Generated by scripts/make_world.py from scenarios/midterm_plus.yaml - edit that file, not this one.
  World frame = map frame: maps/midterm_plus.* is rasterized from this file.
-->

<sdf version="1.9">

  <world name="midterm_plus">

    <!-- Physics -->
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Gazebo core systems -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Required for GPU LiDAR / camera sensors -->
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Ground -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Boundary walls (inner faces on the edges of the [0, w] x [0, h] area) -->

    <!-- south_wall: boundary -->
    <model name="south_wall">
      <static>true</static>
      <pose>2.5 -0.05 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5.2 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.2 0.1 0.5</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- north_wall: boundary -->
    <model name="north_wall">
      <static>true</static>
      <pose>2.5 5.05 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5.2 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.2 0.1 0.5</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- west_wall: boundary -->
    <model name="west_wall">
      <static>true</static>
      <pose>-0.05 2.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 5.2 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 5.2 0.5</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- east_wall: boundary -->
    <model name="east_wall">
      <static>true</static>
      <pose>5.05 2.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 5.2 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 5.2 0.5</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Inner walls -->

    <!-- W1: (0, 3.1) -> (2.25, 3.1) -->
    <model name="W1">
      <static>true</static>
      <pose>1.125 3.1 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.25 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.25 0.1 0.5</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- W1b: (2.2, 3.1) -> (2.2, 3.6) -->
    <model name="W1b">
      <static>true</static>
      <pose>2.2 3.35 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 0.5 0.5</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- W2: (3.4, 0) -> (3.4, 2.8) -->
    <model name="W2">
      <static>true</static>
      <pose>3.4 1.4 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 2.8 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 2.8 0.5</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle boxes -->

    <!-- O2: centre (2.2, 2), 0.6 x 1 -->
    <model name="O2">
      <static>true</static>
      <pose>2.2 2 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 1 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 1 0.4</size></box></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- O3: centre (4.4, 3.6), 0.8 x 0.6 -->
    <model name="O3">
      <static>true</static>
      <pose>4.4 3.6 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.8 0.6 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.6 0.4</size></box></geometry>
          <material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Targets: ArUco stands, pose = target reference point, yaw = direction the marker faces -->

    <include>
      <name>target_S1</name>
      <uri>model://aruco_stand_1</uri>
      <pose>1 4.1 0 0 0 -1.5708</pose>
    </include>

    <include>
      <name>target_C1</name>
      <uri>model://aruco_stand_2</uri>
      <pose>4.1 1 0 0 0 1.5708</pose>
    </include>

    <include>
      <name>target_S2</name>
      <uri>model://aruco_stand_3</uri>
      <pose>0.1 2 0 0 0 0</pose>
    </include>

    <include>
      <name>target_S3</name>
      <uri>model://aruco_stand_4</uri>
      <pose>2.9 0.1 0 0 0 1.5708</pose>
    </include>

    <include>
      <name>target_S4</name>
      <uri>model://aruco_stand_5</uri>
      <pose>0.1 4.5 0 0 0 0</pose>
    </include>

    <include>
      <name>target_C2</name>
      <uri>model://aruco_stand_6</uri>
      <pose>3.6 4.9 0 0 0 -1.5708</pose>
    </include>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.15 0.15 0.15 1</background>
      <shadows>true</shadows>
    </scene>

  </world>

</sdf>
